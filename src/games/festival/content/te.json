    "needs": { "l1": "జాతరలో {{m}} ఖర్చు చేశావు, {{item}} ఇంకా కొనలేదు.", "l2": "అవసరాలు కుటుంబాన్ని నడిపిస్తాయి; కోరికలు అదనం.", "l3": "ముందు అవసరాలు, తర్వాత సరదా.", "term": "అవసరాలు vs కోరికలు", "more": "అవసరం అంటే అది లేకుండా కుటుంబం పండగ చేసుకోలేనిది. కోరిక పండగను ఇంకా సరదాగా చేస్తుంది. రెండూ ముఖ్యమే, కానీ డబ్బు తక్కువైతే ముందు అవసరాలు." },
    "budget": { "l1": "{{pocket}} నుండి {{r}} తీశావు.", "l2": "ప్రతి జేబు తన పని చేస్తేనే బడ్జెట్ పనిచేస్తుంది.", "l3": "ప్లాన్ వేయి, దానికి కట్టుబడి ఉండు.", "term": "బడ్జెట్", "more": "బడ్జెట్ అంటే ఖర్చు చేయకముందే ప్రతి రూపాయికి ఒక పని ఇచ్చే ప్లాన్. అప్పుడప్పుడు మార్చడం పర్వాలేదు, కానీ తరచుగా జరిగితే అది ప్లాన్ కాదు." },
    "opportunity": { "l1": "జాతర అమ్మీ బహుమతి నుండి {{r}} తీసుకుంది.", "l2": "ఒకదానికి ఖర్చైన రూపాయి ఇంకొకదానికి ఉండదు.", "l3": "దేన్ని వదులుకుంటున్నావో అడుగు.", "term": "అవకాశ వ్యయం", "more": "ఒక నిర్ణయం అసలు ఖరీదు, దానికోసం నువ్వు వదులుకున్న మంచి విషయం. ఇక్కడ ఒక సరదా సాయంత్రం ఖరీదు బహుమతిలో కొంత భాగం." },
    "compare": { "l1": "నువ్వు {{p}} ఇచ్చావు; {{stall}}లో అది {{c}}కే ఉంది.", "l2": "ఒకే వస్తువు ధరలు చాలా తేడాగా ఉండొచ్చు.", "l3": "ముందు రెండు షాపులు చూడు.", "term": "ధరలు పోల్చి కొనడం", "more": "కొన్ని అడుగుల దూరంలో ఉన్న షాపుల్లో ఒకే వస్తువు ధరలు చాలా తేడాగా ఉండొచ్చు. కొనే ముందు రెండు మూడు చూస్తే చాలాసార్లు డబ్బు మిగులుతుంది." },
    "cheap": { "l1": "{{cheap}} బట్టలు చిరిగిపోయాయి; కొత్తవి {{new}} అయ్యాయి.", "l2": "తక్కువ ధర, తక్కువ క్వాలిటీ అంటే రెండుసార్లు కట్టాల్సి రావొచ్చు.", "l3": "ధర అంటే విలువ కాదు.", "term": "ధర vs విలువ", "more": "త్వరగా పాడయ్యే చౌక వస్తువు, కొంచెం ఖరీదైనా ఎక్కువ కాలం ఉండే వస్తువు కంటే ఎక్కువ ఖర్చవ్వొచ్చు." },
